# Copy this file to .env (git ignores it) and fill in what you use. `pnpm harness` reads .env by itself;
# a variable already set in your shell wins over the file (documentation/install.md#the-env-file).

# The model. DeepSeek's own API (platform.deepseek.com) is the default provider of a first run.
DEEPSEEK_API_KEY=
# Pin the run's model; without it, `solve` takes the cheapest priced model among the providers with a key.
SESHAT_MODEL=deepseek/deepseek-flash

# The Kimina Lean server that checks proofs (scripts/kimina.sh starts one on 127.0.0.1:8000).
LEAN_SERVER_API_URL=http://127.0.0.1:8000
# Any secret of your choice; scripts/kimina.sh gives the server the same one.
LEAN_SERVER_API_KEY=

# Optional: Jev for typed decisions (documentation/decide.md), through OpenRouter by default.
# JEV_API_KEY=
# JEV_PROVIDER=typesafe
# TYPESAFE_API_KEY=

# Optional: SageMath without Docker (documentation/compute.md#with-pip-no-docker).
# SAGEMATH_MCP_COMMAND=

# Optional: Python on Pyodide, a local copy of the pinned release (documentation/compute.md#installing-pyodide).
# PYODIDE_DIR=
