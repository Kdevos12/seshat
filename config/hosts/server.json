{
  "host": "server",
  "description": "The dedicated server for full bench runs. Kimina Lean Server runs on the same machine and requires its key. The certifier runs lake in the Lean project LEAN_PROJECT_DIR and is unavailable until this profile gives it a sandbox command: this host never runs it unsandboxed (documentation/certifier.md#where-untrusted-code-runs). SageMath runs in its container only. Lean's language server (lean-lsp-mcp, pinned) runs on the project in LEAN_PROJECT_DIR; its searches ask Loogle, LeanSearch, Lean Finder and a premise server over the network. The OEIS, the LMFDB and FindStat are asked over the network, at their public addresses or at OEIS_URL, LMFDB_URL and FINDSTAT_URL. They are optional: `harness health` shows a site that does not answer as a warning and does not fail on it.",
  "capabilities": {
    "lean.check": {
      "use": ["kimina"],
      "settings": {
        "kimina": {
          "url": "${env:LEAN_SERVER_API_URL:-http://localhost:8000}",
          "apiKey": "${env:LEAN_SERVER_API_KEY}"
        }
      },
      "timeoutMs": 1800000
    },
    "lean.meta": {
      "use": ["kimina"],
      "settings": {
        "kimina": {
          "url": "${env:LEAN_SERVER_API_URL:-http://localhost:8000}",
          "apiKey": "${env:LEAN_SERVER_API_KEY}"
        }
      }
    },
    "lean.goals": {
      "use": ["pantograph"],
      "settings": {
        "pantograph": {
          "command": "${env:PANTOGRAPH_REPL:-repl}",
          "cwd": "${env:LEAN_PROJECT_DIR:-}",
          "env": {
            "LEAN_PATH": "${env:LEAN_PATH:-}"
          }
        }
      }
    },
    "lean.lsp": {
      "use": ["lean-lsp-mcp"],
      "settings": {
        "lean-lsp-mcp": {
          "command": "${env:LEAN_LSP_MCP_COMMAND:-uvx}",
          "projectDir": "${env:LEAN_PROJECT_DIR:-}",
          "loogleUrl": "${env:LOOGLE_URL:-}",
          "leanFinderUrl": "${env:LEAN_FINDER_URL:-}",
          "hammerUrl": "${env:LEAN_HAMMER_URL:-}"
        }
      }
    },
    "lean.certify": {
      "use": ["lake"],
      "settings": {
        "lake": {
          "projectDir": "${env:LEAN_PROJECT_DIR:-}",
          "env": {
            "ELAN_HOME": "${env:ELAN_HOME:-}"
          }
        }
      }
    },
    "compute.sage": {
      "use": ["docker"]
    },
    "oeis.search": {
      "use": ["site"],
      "optional": true,
      "settings": {
        "site": {
          "baseUrl": "${env:OEIS_URL:-https://oeis.org}"
        }
      }
    },
    "lmfdb.query": {
      "use": ["site"],
      "optional": true,
      "settings": {
        "site": {
          "baseUrl": "${env:LMFDB_URL:-https://www.lmfdb.org}"
        }
      }
    },
    "findstat.identify": {
      "use": ["site"],
      "optional": true,
      "settings": {
        "site": {
          "baseUrl": "${env:FINDSTAT_URL:-https://www.findstat.org}"
        }
      }
    }
  }
}
