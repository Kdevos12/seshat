{
  "host": "server",
  "description": "The dedicated server for full bench runs. Kimina Lean Server runs on the same machine and requires its key. SageMath runs in its container only. The OEIS, the LMFDB and FindStat are asked over the network, at their public addresses or at OEIS_URL, LMFDB_URL and FINDSTAT_URL. They are optional: `harness health` shows a site that does not answer as a warning and does not fail on it.",
  "capabilities": {
    "lean.check": {
      "use": ["kimina"],
      "settings": {
        "kimina": {
          "url": "${env:LEAN_SERVER_API_URL:-http://localhost:8000}",
          "apiKey": "${env:LEAN_SERVER_API_KEY}"
        }
      },
      "timeoutMs": 1800000
    },
    "lean.meta": {
      "use": ["kimina"],
      "settings": {
        "kimina": {
          "url": "${env:LEAN_SERVER_API_URL:-http://localhost:8000}",
          "apiKey": "${env:LEAN_SERVER_API_KEY}"
        }
      }
    },
    "lean.goals": {
      "use": ["pantograph"],
      "settings": {
        "pantograph": {
          "command": "${env:PANTOGRAPH_REPL:-repl}",
          "cwd": "${env:LEAN_PROJECT_DIR:-}",
          "env": {
            "LEAN_PATH": "${env:LEAN_PATH:-}"
          }
        }
      }
    },
    "compute.sage": {
      "use": ["docker"]
    },
    "oeis.search": {
      "use": ["site"],
      "optional": true,
      "settings": {
        "site": {
          "baseUrl": "${env:OEIS_URL:-https://oeis.org}"
        }
      }
    },
    "lmfdb.query": {
      "use": ["site"],
      "optional": true,
      "settings": {
        "site": {
          "baseUrl": "${env:LMFDB_URL:-https://www.lmfdb.org}"
        }
      }
    },
    "findstat.identify": {
      "use": ["site"],
      "optional": true,
      "settings": {
        "site": {
          "baseUrl": "${env:FINDSTAT_URL:-https://www.findstat.org}"
        }
      }
    }
  }
}
