{
  "host": "server",
  "description": "The dedicated server for full bench runs. Kimina Lean Server runs on the same machine and requires its key. SageMath runs in its container only. Lean's language server (lean-lsp-mcp, pinned) runs on the project in LEAN_PROJECT_DIR; its searches ask Loogle, LeanSearch, Lean Finder and a premise server over the network.",
  "capabilities": {
    "lean.check": {
      "use": ["kimina"],
      "settings": {
        "kimina": {
          "url": "${env:LEAN_SERVER_API_URL:-http://localhost:8000}",
          "apiKey": "${env:LEAN_SERVER_API_KEY}"
        }
      },
      "timeoutMs": 1800000
    },
    "lean.meta": {
      "use": ["kimina"],
      "settings": {
        "kimina": {
          "url": "${env:LEAN_SERVER_API_URL:-http://localhost:8000}",
          "apiKey": "${env:LEAN_SERVER_API_KEY}"
        }
      }
    },
    "lean.goals": {
      "use": ["pantograph"],
      "settings": {
        "pantograph": {
          "command": "${env:PANTOGRAPH_REPL:-repl}",
          "cwd": "${env:LEAN_PROJECT_DIR:-}",
          "env": {
            "LEAN_PATH": "${env:LEAN_PATH:-}"
          }
        }
      }
    },
    "lean.lsp": {
      "use": ["lean-lsp-mcp"],
      "settings": {
        "lean-lsp-mcp": {
          "command": "${env:LEAN_LSP_MCP_COMMAND:-uvx}",
          "projectDir": "${env:LEAN_PROJECT_DIR:-}",
          "loogleUrl": "${env:LOOGLE_URL:-}",
          "leanFinderUrl": "${env:LEAN_FINDER_URL:-}",
          "hammerUrl": "${env:LEAN_HAMMER_URL:-}"
        }
      }
    },
    "compute.sage": {
      "use": ["docker"]
    }
  }
}
