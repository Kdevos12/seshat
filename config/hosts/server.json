{
  "host": "server",
  "description": "The dedicated server for full bench runs. Kimina Lean Server runs on the same machine and requires its key. SageMath runs in its container only.",
  "capabilities": {
    "lean.check": {
      "use": ["kimina"],
      "settings": {
        "kimina": {
          "url": "${env:LEAN_SERVER_API_URL:-http://localhost:8000}",
          "apiKey": "${env:LEAN_SERVER_API_KEY}"
        }
      },
      "timeoutMs": 1800000
    },
    "lean.meta": {
      "use": ["kimina"],
      "settings": {
        "kimina": {
          "url": "${env:LEAN_SERVER_API_URL:-http://localhost:8000}",
          "apiKey": "${env:LEAN_SERVER_API_KEY}"
        }
      }
    },
    "lean.goals": {
      "use": ["pantograph"],
      "settings": {
        "pantograph": {
          "command": "${env:PANTOGRAPH_REPL:-repl}",
          "cwd": "${env:LEAN_PROJECT_DIR:-}",
          "env": {
            "LEAN_PATH": "${env:LEAN_PATH:-}"
          }
        }
      }
    },
    "compute.sage": {
      "use": ["docker"]
    }
  }
}
