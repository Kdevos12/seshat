{
  "host": "server",
  "leanEnv": "${env:LEAN_ENV:-base}",
  "description": "The dedicated server for full bench runs. Kimina Lean Server runs on the same machine and requires its key. The Lean environment is LEAN_ENV (default base, lean/env/base.toml): a run records its hash, and LEAN_PROJECT_DIR defaults to the environment's project once `harness lean-env build` has built it. The certifier runs lake in the Lean project LEAN_PROJECT_DIR and is unavailable until this profile gives it a sandbox command: this host never runs it unsandboxed (documentation/certifier.md#where-untrusted-code-runs). SageMath runs in its container only. Lean's language server (lean-lsp-mcp, pinned) runs on the project in LEAN_PROJECT_DIR; its searches ask Loogle, LeanSearch, Lean Finder and a premise server over the network. The OEIS, the LMFDB and FindStat are asked over the network, at their public addresses or at OEIS_URL, LMFDB_URL and FINDSTAT_URL. They are optional: `harness health` shows a site that does not answer as a warning and does not fail on it. The Jev backend of decide.ask (documentation/decide.md) sends the states and questions of decisions to a third party, OpenRouter or TypeSafe AI, at the hosts this profile allows, and only when a run asks for it (--decide-backend jev or --decide-site) and a key is set: JEV_PROVIDER picks openrouter (the default: OpenRouter's Decisions endpoint, key OPENROUTER_API_KEY, else JEV_API_KEY) or typesafe (TypeSafe's own System One API, key TYPESAFE_API_KEY, else JEV_API_KEY), each with its pinned model and price below, which JEV_MODEL, JEV_BASE_URL and JEV_PATH replace; otherwise the run's model decides. The models section prices DeepSeek's own API (provider deepseek, key DEEPSEEK_API_KEY) at its peak rates, with the off-peak calendar that halves them.",
  "models": {
    "deepseek/deepseek-flash": {
      "pricing": {
        "cacheHit": 0.006,
        "cacheMiss": 0.3,
        "output": 1.2,
        "calendar": {
          "peak": [
            { "days": [1, 2, 3, 4, 5], "from": "01:00", "to": "04:00" },
            { "days": [1, 2, 3, 4, 5], "from": "06:00", "to": "10:00" }
          ],
          "offPeakMultiplier": 0.5
        }
      },
      "ignores": { "thinking": ["temperature"] }
    },
    "deepseek/deepseek-v4-pro": {
      "pricing": {
        "cacheHit": 0.044,
        "cacheMiss": 1.32,
        "output": 3.96,
        "calendar": {
          "peak": [
            { "days": [1, 2, 3, 4, 5], "from": "01:00", "to": "04:00" },
            { "days": [1, 2, 3, 4, 5], "from": "06:00", "to": "10:00" }
          ],
          "offPeakMultiplier": 0.5
        }
      },
      "ignores": { "thinking": ["temperature"] }
    }
  },
  "capabilities": {
    "lean.check": {
      "use": ["kimina"],
      "settings": {
        "kimina": {
          "url": "${env:LEAN_SERVER_API_URL:-http://localhost:8000}",
          "apiKey": "${env:LEAN_SERVER_API_KEY}"
        }
      },
      "timeoutMs": 1800000
    },
    "lean.meta": {
      "use": ["kimina"],
      "settings": {
        "kimina": {
          "url": "${env:LEAN_SERVER_API_URL:-http://localhost:8000}",
          "apiKey": "${env:LEAN_SERVER_API_KEY}"
        }
      }
    },
    "lean.goals": {
      "use": ["pantograph"],
      "settings": {
        "pantograph": {
          "command": "${env:PANTOGRAPH_REPL:-repl}",
          "cwd": "${env:LEAN_PROJECT_DIR:-}",
          "env": {
            "LEAN_PATH": "${env:LEAN_PATH:-}"
          }
        }
      }
    },
    "lean.lsp": {
      "use": ["lean-lsp-mcp"],
      "settings": {
        "lean-lsp-mcp": {
          "command": "${env:LEAN_LSP_MCP_COMMAND:-uvx}",
          "projectDir": "${env:LEAN_PROJECT_DIR:-}",
          "loogleUrl": "${env:LOOGLE_URL:-}",
          "leanFinderUrl": "${env:LEAN_FINDER_URL:-}",
          "hammerUrl": "${env:LEAN_HAMMER_URL:-}"
        }
      }
    },
    "lean.certify": {
      "use": ["lake"],
      "settings": {
        "lake": {
          "projectDir": "${env:LEAN_PROJECT_DIR:-}",
          "env": {
            "ELAN_HOME": "${env:ELAN_HOME:-}"
          }
        }
      }
    },
    "compute.sage": {
      "use": ["docker"]
    },
    "decide.ask": {
      "use": ["jev"],
      "optional": true,
      "settings": {
        "jev": {
          "provider": "${env:JEV_PROVIDER:-openrouter}",
          "baseUrl": "${env:JEV_BASE_URL:-}",
          "path": "${env:JEV_PATH:-}",
          "apiKey": "${env:JEV_API_KEY:-}",
          "model": "${env:JEV_MODEL:-}",
          "providers": {
            "openrouter": {
              "baseUrl": "https://openrouter.ai/api/alpha",
              "path": "/decisions",
              "apiKey": "${env:OPENROUTER_API_KEY:-}",
              "model": "typesafe/jev-1.14",
              "inputUsdPerMillion": 0.042,
              "outputUsdPerMillion": 0
            },
            "typesafe": {
              "baseUrl": "https://api.typesafe.ai/v1",
              "path": "/systemone",
              "apiKey": "${env:TYPESAFE_API_KEY:-}",
              "model": "jev-1.14.0",
              "inputUsdPerMillion": 0.042,
              "outputUsdPerMillion": 0
            }
          },
          "allowedHosts": ["openrouter.ai", "api.typesafe.ai"]
        }
      }
    },
    "prove.auto": {
      "use": ["battery"],
      "settings": {
        "battery": {
          "url": "${env:LEAN_SERVER_API_URL:-http://localhost:8000}",
          "apiKey": "${env:LEAN_SERVER_API_KEY}",
          "packages": "${env:M10_PACKAGES:-}"
        }
      }
    },
    "prove.search": {
      "use": ["pantograph"],
      "settings": {
        "pantograph": {
          "command": "${env:PANTOGRAPH_REPL:-repl}",
          "cwd": "${env:LEAN_PROJECT_DIR:-}",
          "env": {
            "LEAN_PATH": "${env:LEAN_PATH:-}"
          }
        }
      }
    },
    "smt.z3": {
      "use": ["process"],
      "optional": true,
      "settings": { "process": { "command": "${env:Z3_COMMAND:-z3}" } }
    },
    "atp.vampire": {
      "use": ["process"],
      "optional": true,
      "settings": { "process": { "command": "${env:VAMPIRE_COMMAND:-vampire}" } }
    },
    "atp.eprover": {
      "use": ["process"],
      "optional": true,
      "settings": { "process": { "command": "${env:EPROVER_COMMAND:-eprover}" } }
    },
    "oeis.search": {
      "use": ["site"],
      "optional": true,
      "settings": {
        "site": {
          "baseUrl": "${env:OEIS_URL:-https://oeis.org}"
        }
      }
    },
    "lmfdb.query": {
      "use": ["site"],
      "optional": true,
      "settings": {
        "site": {
          "baseUrl": "${env:LMFDB_URL:-https://www.lmfdb.org}"
        }
      }
    },
    "lit.search": {
      "use": ["sources"],
      "optional": true,
      "settings": {
        "sources": {
          "backends": {
            "openalex": { "baseUrl": "${env:OPENALEX_URL:-https://api.openalex.org}", "allowedHosts": ["api.openalex.org"] },
            "arxiv": { "baseUrl": "${env:ARXIV_URL:-https://export.arxiv.org}", "allowedHosts": ["export.arxiv.org"] },
            "semantic-scholar": { "baseUrl": "${env:SEMANTIC_SCHOLAR_URL:-https://api.semanticscholar.org}", "allowedHosts": ["api.semanticscholar.org"] },
            "zbmath": { "baseUrl": "${env:ZBMATH_URL:-https://api.zbmath.org}", "allowedHosts": ["api.zbmath.org"] },
            "bench-metadata": { "dir": "${env:BENCH_CHECKOUT:-}" }
          }
        }
      }
    },
    "findstat.identify": {
      "use": ["site"],
      "optional": true,
      "settings": {
        "site": {
          "baseUrl": "${env:FINDSTAT_URL:-https://www.findstat.org}"
        }
      }
    },
    "lean.search": {
      "use": ["search"],
      "optional": true,
      "settings": {
        "search": {
          "allowedHosts": ["leansearch.net", "loogle.lean-lang.org"],
          "remoteUrl": "${env:LEAN_SEARCH_URL:-}",
          "patternUrl": "${env:LEAN_PATTERN_URL:-}",
          "index": "${env:LEAN_SEARCH_INDEX:-}"
        }
      }
    }
  }
}
