{
  "host": "local",
  "description": "A workstation. Kimina Lean Server runs on this machine, or LEAN_SERVER_API_URL points to the dedicated server's. SageMath runs in its container when Docker is there, otherwise from a local install (SAGEMATH_MCP_COMMAND, default sagemath-mcp). Lean's language server (lean-lsp-mcp, pinned) runs on the project in LEAN_PROJECT_DIR, started with uvx or by LEAN_LSP_MCP_COMMAND; its searches ask Loogle, LeanSearch, Lean Finder and a premise server over the network, or the sites at LOOGLE_URL, LEAN_FINDER_URL and LEAN_HAMMER_URL.",
  "capabilities": {
    "lean.check": {
      "use": ["kimina"],
      "settings": {
        "kimina": {
          "url": "${env:LEAN_SERVER_API_URL:-http://localhost:8000}",
          "apiKey": "${env:LEAN_SERVER_API_KEY:-}"
        }
      }
    },
    "lean.meta": {
      "use": ["kimina"],
      "settings": {
        "kimina": {
          "url": "${env:LEAN_SERVER_API_URL:-http://localhost:8000}",
          "apiKey": "${env:LEAN_SERVER_API_KEY:-}"
        }
      }
    },
    "lean.goals": {
      "use": ["pantograph"],
      "settings": {
        "pantograph": {
          "command": "${env:PANTOGRAPH_REPL:-repl}",
          "cwd": "${env:LEAN_PROJECT_DIR:-}",
          "env": {
            "LEAN_PATH": "${env:LEAN_PATH:-}"
          }
        }
      }
    },
    "lean.lsp": {
      "use": ["lean-lsp-mcp"],
      "settings": {
        "lean-lsp-mcp": {
          "command": "${env:LEAN_LSP_MCP_COMMAND:-uvx}",
          "projectDir": "${env:LEAN_PROJECT_DIR:-}",
          "loogleUrl": "${env:LOOGLE_URL:-}",
          "leanFinderUrl": "${env:LEAN_FINDER_URL:-}",
          "hammerUrl": "${env:LEAN_HAMMER_URL:-}"
        }
      }
    },
    "compute.sage": {
      "use": ["docker", "local"],
      "settings": {
        "local": {
          "command": "${env:SAGEMATH_MCP_COMMAND:-sagemath-mcp}"
        }
      }
    }
  }
}
