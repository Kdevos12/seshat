{
  "host": "local",
  "description": "A workstation. Kimina Lean Server runs on this machine, or LEAN_SERVER_API_URL points to the dedicated server's. The certifier runs lake in the Lean project LEAN_PROJECT_DIR. SageMath runs in its container when Docker is there, otherwise from a local install (SAGEMATH_MCP_COMMAND, default sagemath-mcp).",
  "capabilities": {
    "lean.check": {
      "use": ["kimina"],
      "settings": {
        "kimina": {
          "url": "${env:LEAN_SERVER_API_URL:-http://localhost:8000}",
          "apiKey": "${env:LEAN_SERVER_API_KEY:-}"
        }
      }
    },
    "lean.meta": {
      "use": ["kimina"],
      "settings": {
        "kimina": {
          "url": "${env:LEAN_SERVER_API_URL:-http://localhost:8000}",
          "apiKey": "${env:LEAN_SERVER_API_KEY:-}"
        }
      }
    },
    "lean.goals": {
      "use": ["pantograph"],
      "settings": {
        "pantograph": {
          "command": "${env:PANTOGRAPH_REPL:-repl}",
          "cwd": "${env:LEAN_PROJECT_DIR:-}",
          "env": {
            "LEAN_PATH": "${env:LEAN_PATH:-}"
          }
        }
      }
    },
    "lean.certify": {
      "use": ["lake"],
      "settings": {
        "lake": {
          "projectDir": "${env:LEAN_PROJECT_DIR:-}",
          "env": {
            "ELAN_HOME": "${env:ELAN_HOME:-}"
          }
        }
      }
    },
    "compute.sage": {
      "use": ["docker", "local"],
      "settings": {
        "local": {
          "command": "${env:SAGEMATH_MCP_COMMAND:-sagemath-mcp}"
        }
      }
    }
  }
}
